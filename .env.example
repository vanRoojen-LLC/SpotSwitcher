# Optional SpotSwitcher email notifications through Toby's shared CFES Worker.
# Store CFES_HMAC_SECRET in Azure Key Vault tvr-shared-tv001-kv, not in this file.
CFES_ENDPOINT=https://cloudflare-email-sender.toby-vanroojen.workers.dev/v1/send
CFES_CLIENT_ID=spotswitcher
CFES_HMAC_SECRET=<hydrated-from-key-vault>

# Optional default recipients. You can also pass -NotificationEmailTo.
SPOTSWITCHER_NOTIFICATION_TO=ops@example.com
